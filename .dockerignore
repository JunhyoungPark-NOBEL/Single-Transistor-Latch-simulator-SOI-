# keep the build context small; caches are rebuilt by scripts/warmup.py inside the image
.git
.github
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
*.log
.env
.venv
venv
server/.cache
engine/photo_extension/photo_nodes
engine/model/**/fpt_nodes
engine/model/**/conditional_table
engine/model/**/fast_fpt
web/node_modules
web/dist
web/test-results
web/playwright-report
web/.vite
# lab-server kit: the image needs none of it (and a local deploy/lab/stl.env would hold secrets)
deploy/lab
# legacy Streamlit app (not part of the web simulator image)
app.py
config.toml
requirements.txt
# local installer kit sources and built kits: not part of the app image
deploy/local
dist-local
