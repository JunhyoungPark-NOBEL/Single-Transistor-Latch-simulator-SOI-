# Copy OUTSIDE the project, e.g. /etc/biristor-studio/server.env (chmod 600).
# Fill the two empty values below. No real secret is distributed with this project.
STL_ACCESS_PASSWORD=
STL_SESSION_SECRET=
STL_REQUIRE_PASSWORD=1
# For nginx -> Docker only. The published port must stay on 127.0.0.1.
STL_TRUST_PROXY=1
FORWARDED_ALLOW_IPS=*
# Exact browser origins only; add a separate frontend origin when needed.
STL_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
