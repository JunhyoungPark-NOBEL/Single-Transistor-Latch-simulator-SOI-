# STL simulator — reverse proxy in front of the app (deploy/lab/docker-compose.yml, docs/DEPLOY_LAB.md)
#
# Settings come from the caddy container's environment, i.e. from stl.env:
#   STL_SITE_ADDRESS    name(s) the site answers to, comma-separated:
#                         stl.example.ac.kr                  (a real DNS name → STL_TLS_MODE=acme)
#                         143.248.12.34, stl-server.local     (campus IP / hostname → STL_TLS_MODE=internal)
#   STL_TLS_MODE        acme     → Let's Encrypt certificate; needs a real DNS name pointing at this server and
#                                  ports 80 + 443 reachable from the internet. Adds HSTS.
#                       internal → certificate from Caddy's own local CA (no internet needed; browsers warn until
#                                  its root certificate is installed, docs/DEPLOY_LAB.md). No HSTS.
#   STL_NET_SUBNET      internal docker network (backend); only the tunnel containers on it may set the client address
#   STL_MAX_BODY_KB     request body limit in KiB, shared with the app (default 256). The proxy refuses a larger body
#                       itself, from its Content-Length, with the app's JSON 413: forwarded, the app would refuse it
#                       from the header and close the connection while the proxy is still sending the body, which
#                       races and often surfaces as a 502.
# {$VAR:default} placeholders are replaced before the file is parsed.
# Pinned on the server: the updater runs $STL_HOME/kit/Caddyfile, installed (after a validity check) by install.sh.
{
	# Caddy's local CA must not try to install itself into the (read-only) container trust store
	skip_install_trust
	servers {
		# Requests from the tunnel containers carry the visitor's address in X-Forwarded-For: Tailscale Funnel sets it
		# to the visitor, Cloudflare appends the visitor as the right-most entry. Trusted only from the internal
		# network, and strict = the right-most address that is not on that network, so entries a visitor wrote
		# into the header themselves are never used. Direct visitors cannot set it at all (they are not on the
		# internal network). Only X-Forwarded-For: the Tailscale serve proxy passes other request headers through
		# unchanged, so a Funnel visitor could forge e.g. CF-Connecting-IP.
		trusted_proxies static {$STL_NET_SUBNET:172.30.83.0/24}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		timeouts {
			read_header 15s
			read_body 60s
			idle 5m
		}
	}
}

# --- TLS mode snippets, chosen by `import tls_{$STL_TLS_MODE}` below -------------------------------------------------
(tls_acme) {
	# real domain with a publicly trusted certificate: tell browsers to use HTTPS only
	header Strict-Transport-Security "max-age=31536000"
}

(tls_internal) {
	tls internal
}

# --- shared proxy settings -------------------------------------------------------------------------------------------
(stl_proxy) {
	encode zstd gzip

	# oversized bodies are refused here, with the app's own message (the web page shows the same error either way)
	@too_large expression {http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > {$STL_MAX_BODY_KB:256} * 1024
	handle @too_large {
		header Content-Type "application/json"
		respond `{"detail":"request body too large (limit {$STL_MAX_BODY_KB:256} KiB)"}` 413
	}
	# bodies without Content-Length (chunked uploads)
	request_body {
		max_size {$STL_MAX_BODY_KB:256}KiB
	}

	header {
		# applied when the response is written, so headers added by the proxy (Via) can be removed too
		defer
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# added as a separate header, so the login page's own (stricter) Content-Security-Policy stays in force
		+Content-Security-Policy "frame-ancestors 'none'"
		?X-Robots-Tag "noindex, nofollow"
		-Server
		-Via
	}

	reverse_proxy app:8000 {
		# exactly one address: the visitor as Caddy resolved it (STL_TRUST_PROXY=1 in the app reads this entry)
		header_up X-Forwarded-For {client_ip}
		# read the whole body (at most max_size) before contacting the app: slow uploads never tie up the app, and an
		# oversized body gets a clean 413 here instead of a 502 when the app refuses it early
		request_buffers 8MB
		# while the app restarts (deploy, rollback) requests wait up to 30 s instead of failing at once
		lb_try_duration 30s
		lb_try_interval 1s
		transport http {
			dial_timeout 5s
			# compute requests long-poll for up to 60 s (?wait=, server/main.py MAX_WAIT_S)
			response_header_timeout 120s
		}
	}
}

# --- the site ---------------------------------------------------------------------------------------------------------
{$STL_SITE_ADDRESS:localhost} {
	import tls_{$STL_TLS_MODE:internal}
	import stl_proxy
}

# Plain-HTTP entrance for the tunnel containers only (they terminate HTTPS themselves). Port 8080 is not published
# on the host.
http://:8080 {
	import stl_proxy
}
