# STL simulator — rebuild the deployed commit on fresh base images (python, node) and pull the proxy image, so their
# security updates arrive without a code change (deploy/lab/update.sh --refresh, docs/DEPLOY_LAB.md §6.7).
# Started weekly by stl-refresh.timer; switches (canary first) only when an image actually changed.
#   journalctl -u stl-refresh          what the last refresh did
#   systemctl start stl-refresh        refresh now

[Unit]
Description=STL simulator: refresh base images of the deployed version
Documentation=file:///opt/stl-sim/app/docs/DEPLOY_LAB.md
Wants=network-online.target
After=network-online.target docker.service stl-compose.service
ConditionPathExists=/opt/stl-sim/stl.env

[Service]
Type=oneshot
User=stl
Environment=STL_HOME=/opt/stl-sim
ExecStart=/opt/stl-sim/bin/update.sh --refresh
# 75 = another update run holds the lock: not a failure
SuccessExitStatus=75
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
