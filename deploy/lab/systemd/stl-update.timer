# STL simulator — look for new commits every 5 minutes (runs stl-update.service).
#   systemctl list-timers stl-update.timer      next / last run
#   systemctl stop stl-update.timer             pause automatic deploys (or: sudo stl-lab --pause)

[Unit]
Description=STL simulator: check the deploy branch every 5 minutes
Documentation=file:///opt/stl-sim/app/docs/DEPLOY_LAB.md

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=60
AccuracySec=15s
# catch up on a run missed while the server was off
Persistent=true
Unit=stl-update.service

[Install]
WantedBy=timers.target
