# STL simulator — deploy new commits of the deploy branch (deploy/lab/update.sh, docs/DEPLOY_LAB.md).
# Started every 5 minutes by stl-update.timer. install.sh installs this file into /etc/systemd/system/ with the
# paths and the user of the actual installation (defaults: /opt/stl-sim, user stl). The updater it runs is the
# root-owned, pinned copy in /opt/stl-sim/bin (never a file of a pushed commit).
#   journalctl -u stl-update -f          follow the deploy log
#   systemctl start stl-update           check for a new commit right now

[Unit]
Description=STL simulator: deploy new commits of the deploy branch
Documentation=file:///opt/stl-sim/app/docs/DEPLOY_LAB.md
Wants=network-online.target
After=network-online.target docker.service stl-compose.service
ConditionPathExists=/opt/stl-sim/stl.env

[Service]
Type=oneshot
User=stl
Environment=STL_HOME=/opt/stl-sim
ExecStart=/opt/stl-sim/bin/update.sh
# 75 = another update run holds the lock: not a failure
SuccessExitStatus=75
# a cold build (npm + pip + numba warm-up) takes 5–15 min
TimeoutStartSec=45min
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=yes
PrivateTmp=yes
